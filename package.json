{
  "name": "elysia-azurefunc-adapter",
  "version": "1.0.0",
  "description": "Azure Functions adapter for Elysia. Run Elysia on Azure Functions.",
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/elysia-azurefunc-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/elysia-azurefunc-adapter/issues"
  },
  "homepage": "https://github.com/your-username/elysia-azurefunc-adapter#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/your-username"
  },
  "keywords": [
    "elysia",
    "azure",
    "azure-functions",
    "serverless",
    "faas",
    "http",
    "web-framework",
    "typescript",
    "bun"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "publint && attw --pack .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && npm run lint && changeset publish",
    "prepublishOnly": "npm run build",
    "size": "size-limit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.15.0",
    "@azure/functions": "^4.1.0",
    "@changesets/cli": "^2.29.7",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@types/node": "^20.10.0",
    "elysia": "^1.4.16",
    "publint": "^0.2.0",
    "size-limit": "^11.0.0",
    "tsdown": "^0.16.0",
    "typescript": "^5.3.2"
  },
  "peerDependencies": {
    "@azure/functions": "^4.0.0",
    "elysia": ">=1.0.0"
  },
  "size-limit": [
    {
      "path": "dist/index.mjs",
      "limit": "5 KB"
    }
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
